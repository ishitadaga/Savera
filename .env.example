# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ===================
# BACKEND VARIABLES
# ===================

# Google Cloud API Key (required)
# Enable: Solar API, Maps Static API, Geocoding API, Places API
GOOGLE_SOLAR_API_KEY=your_google_api_key_here

# CORS - Allowed frontend origins (comma-separated)
# Local:
ALLOWED_ORIGINS=http://localhost:3000
# Production (update after Vercel deploy):
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-domain.com

# ===================
# FRONTEND VARIABLES
# ===================

# Backend URL (for frontend to call API)
# Local development:
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001
# Production (update after deploying backend):
# NEXT_PUBLIC_BACKEND_URL=https://your-backend.railway.app
